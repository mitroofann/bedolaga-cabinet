# ── Блок для маркетингового сайта. Добавьте его в СУЩЕСТВУЮЩИЙ Caddyfile
#    (тот, что уже раздаёт кабинет на 443), рядом с блоком cabinet.*.
#    НЕ запускайте site/docker-compose.yml на этом же сервере — иначе два
#    процесса будут драться за порт 443. Один Caddy обслуживает оба домена
#    по имени.
#
# Файлы сайта положите в /srv/mainpage (как кабинет лежит в /srv/cabinet):
#   sudo mkdir -p /srv/mainpage && sudo cp -r mainpage/* /srv/mainpage/
# затем перезагрузите Caddy:
#   docker exec <caddy_container> caddy reload --config /etc/caddy/Caddyfile
# (или `caddy reload`, если Caddy запущен на хосте).

# Маркетинговый сайт (главная)
https://bulkavpn.net {
    encode gzip zstd

    handle {
        root * /srv/mainpage
        try_files {path} /index.html
        file_server

        @static path *.js *.css *.woff *.woff2 *.ttf *.ico *.png *.jpg *.jpeg *.svg *.webp *.gif
        header @static Cache-Control "public, max-age=31536000, immutable"

        @html path *.html /
        header @html Cache-Control "no-cache, must-revalidate"
    }
}
